files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/01_restart_puma.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      sudo mkdir -p /var/run/puma
      sudo chown webapp:webapp /var/run/puma
      sudo chmod 755 /var/run/puma
      
      # Create log directory
      sudo mkdir -p /var/app/current/log
      sudo chown webapp:webapp /var/app/current/log
      
      # Kill any existing Puma processes
      sudo pkill -f puma || true
      sleep 2
      
      # Start Puma as webapp user
      cd /var/app/current
      sudo -u webapp -E RAILS_ENV=production bundle exec puma -C config/puma.rb

commands:
  01_setup_puma_directory:
    command: |
      mkdir -p /var/run/puma
      chown webapp:webapp /var/run/puma
      chmod 755 /var/run/puma
      mkdir -p /var/app/current/tmp/pids
      chown -R webapp:webapp /var/app/current/tmp